SECRET_KEY=replace_with_a_random_secret_key
# Optional database URI; defaults to the local sentiment.db SQLite database.
# DATABASE_URL=sqlite:///sentiment.db

# MongoDB stores account credentials. Connect to the sentimentiq database in Compass.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sentimentiq

# Configure SMTP and the public app URL to enable password-reset emails.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_DEFAULT_SENDER=SentimentIQ <no-reply@example.com>
PUBLIC_BASE_URL=https://your-public-domain.example
# Local development only: print reset OTPs to the server terminal. Keep false in production.
PASSWORD_RESET_CONSOLE_OTP=false

GROQ_API_KEY=replace_with_your_groq_key
# Optional: change the Groq model used for sentiment analysis
GROQ_MODEL=llama-3.3-70b-versatile
